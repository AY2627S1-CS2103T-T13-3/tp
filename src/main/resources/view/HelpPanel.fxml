<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="helpPanelContainer" styleClass="pane-with-border" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="10" right="10" bottom="10" left="10" />
  </padding>
  <HBox alignment="CENTER_LEFT">
    <Label text="COMMANDS" styleClass="panel-header" />
    <Region HBox.hgrow="ALWAYS" />
    <Button fx:id="closeButton" text="✕" onAction="#handleClose" styleClass="help-close-button" />
  </HBox>
  <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="help-scroll-pane">
    <VBox spacing="10">
      <padding>
        <Insets top="8" right="4" bottom="8" left="2" />
      </padding>
      <VBox fx:id="commandsContainer" spacing="8" />
    </VBox>
  </ScrollPane>
</VBox>
