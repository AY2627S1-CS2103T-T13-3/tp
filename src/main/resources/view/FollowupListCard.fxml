<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="followupCardPane" fx:id="followupCardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane minWidth="0" HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" minWidth="0" percentWidth="100" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minWidth="0" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <HBox spacing="0.5" alignment="TOP_LEFT" minWidth="0">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="description" text="\$first" styleClass="cell_big_label" wrapText="true" minWidth="0" maxWidth="Infinity" minHeight="-Infinity" />
      </HBox>
        <Label fx:id="contact" styleClass="cell_contact" text="\$contact" wrapText="true" minWidth="0" maxWidth="Infinity" minHeight="-Infinity" />
    </VBox>
  </GridPane>
</HBox>
