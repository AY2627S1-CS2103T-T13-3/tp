@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant "CommandWords" as CommandWords LOGIC_COLOR
participant "commandInfo:CommandInfo" as CommandInfo LOGIC_COLOR
participant ":DeleteContactCommandParser" as DeleteContactCommandParser LOGIC_COLOR
participant "d:DeleteContactCommand" as DeleteContactCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("deletecontact 1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("deletecontact 1")
activate AddressBookParser

AddressBookParser -> CommandWords : getCommandInfo("deletecontact")
activate CommandWords

CommandWords --> AddressBookParser : commandInfo
deactivate CommandWords

AddressBookParser -> CommandInfo : parse("1")
activate CommandInfo

CommandInfo -> DeleteContactCommandParser : parse("1")
activate DeleteContactCommandParser

create DeleteContactCommand
DeleteContactCommandParser -> DeleteContactCommand
activate DeleteContactCommand

DeleteContactCommand --> DeleteContactCommandParser :
deactivate DeleteContactCommand

DeleteContactCommandParser --> CommandInfo : d
deactivate DeleteContactCommandParser

CommandInfo --> AddressBookParser : d
deactivate CommandInfo

AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> DeleteContactCommand : execute(m)
activate DeleteContactCommand

DeleteContactCommand -> Model : getFilteredContactList()
activate Model

Model --> DeleteContactCommand : lastShownList
deactivate Model

note right of DeleteContactCommand : contactToDelete = lastShownList.get(0)

DeleteContactCommand -> Model : deleteContact(contactToDelete)
activate Model

Model --> DeleteContactCommand
deactivate Model

create CommandResult
DeleteContactCommand -> CommandResult
activate CommandResult

CommandResult --> DeleteContactCommand
deactivate CommandResult

DeleteContactCommand --> LogicManager : r
deactivate DeleteContactCommand

[<--LogicManager
deactivate LogicManager
@enduml
