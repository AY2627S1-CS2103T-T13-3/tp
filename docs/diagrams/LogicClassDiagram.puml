@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {
Class "<<interface>>\nParser" as Parser
Class AddressBookParser
Class CommandWords
Class CommandInfo
Class XYZCommand
Class CommandResult
Class "{abstract}\nCommand" as Command

Class "<<interface>>\nLogic" as Logic
Class LogicManager
}

package Model {
Class HiddenModel #FFFFFF
}

package Storage {
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Logic

LogicManager .right.|> Logic
LogicManager -down->"1" AddressBookParser
AddressBookParser ..> CommandWords : <<use>>
AddressBookParser ..> CommandInfo : <<use>>
CommandWords --> "*" CommandInfo
CommandInfo --> "0..1" Parser
Parser ..> Command : <<use>>

XYZCommand -up-|> Command
LogicManager .left.> Command : <<execute>>

LogicManager --> Model
LogicManager -->"1" Storage : <<save>>
Storage --[hidden] Model
Command .[hidden]up.> Storage
Command .right.> Model
note right of XYZCommand: XYZCommand = AddContactCommand, \nFindContactsCommand, etc

Logic ..> CommandResult
LogicManager .down.> CommandResult
Command .up.> CommandResult : <<create>>
@enduml
